# ─────────────────────────────────────────────────────────────────────────────
# Marketing Generation — environment configuration
# ─────────────────────────────────────────────────────────────────────────────
# Copy this file to `.env` and fill in real values. `.env` is gitignored.
# Never commit real keys. Rotate any key that has ever appeared in chat,
# screenshots, error reports, or a public repo.
# ─────────────────────────────────────────────────────────────────────────────


# ── LLM (plan + script) ──────────────────────────────────────────────────────
MINIMAX_API_KEY=sk-your-key-here
MINIMAX_BASE_URL=https://api.minimax.io/v1
MINIMAX_MODEL=MiniMax-M3


# ── Video / image generation ─────────────────────────────────────────────────
WAVESPEED_API_KEY=ws-your-key-here
# Video model (reference-image guided, clip-based).
# See https://wavespeed.ai/models/minimax/h3/reference-to-video
WAVESPEED_VIDEO_MODEL=minimax/h3/reference-to-video
WAVESPEED_VIDEO_MAX_DURATION_S=15
WAVESPEED_VIDEO_MAX_SCENES=6
# Image model (text -> image).
WAVESPEED_IMAGE_MODEL=wavespeed-ai/z-image/turbo
# Image model (reference-image guided, image -> image).
WAVESPEED_I2I_MODEL=wavespeed-ai/z-image-turbo/image-to-image


# ── Web scraper CLI ──────────────────────────────────────────────────────────
# See https://github.com/agent-browser/agent-browser
AGENT_BROWSER_BIN=agent-browser


# ── On-host paths ────────────────────────────────────────────────────────────
# Where generated frames, scripts, and stitched videos are written.
# Must be writable by the process running uvicorn (the user the service runs as).
OUTPUT_DIR=/home/jaime/marketing-generation/output


# ── Stripe (credit purchases) ────────────────────────────────────────────────
# Restricted key — never the full secret key. Treat as a password.
STRIPE_RK_LIVE=rk_live_REPLACE_ME
# Webhook signing secret, from `stripe listen` (dev) or the dashboard (prod).
STRIPE_WEBHOOK_SECRET=whsec_REPLACE_ME


# ── JWT + vault signing key ──────────────────────────────────────────────────
# Generated once with `python -c 'import secrets; print(secrets.token_urlsafe(48))'`.
# Rotating this invalidates every existing session and forces re-encryption of
# the Gmail SMTP vault. Keep file mode 600 and do not commit the real value.
vault_key=__GENERATE_WITH_SECRETS_TOKEN_URLSAFE_48__
