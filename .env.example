MINIMAX_API_KEY=sk-your-key-here
MINIMAX_BASE_URL=https://agent.minimax.io/mavis/api/v1/llm/v1
WAVESPEED_API_KEY=ws-your-key-here
# Video model. Defaults to the reference-to-video model which supports
# 2-30s clips driven by up to 10 reference images plus optional audio.
# See https://wavespeed.ai/models/alibaba/wan-3.0/reference-to-video
# WAVESPEED_VIDEO_MODEL=alibaba/wan-3.0/reference-to-video
# WAVESPEED_VIDEO_MAX_DURATION_S=30
# WAVESPEED_VIDEO_MAX_SCENES=3
# Image model (text -> image).
# WAVESPEED_IMAGE_MODEL=gpt-image-2.0image
# Web scraper CLI. See https://github.com/agent-browser/agent-browser
AGENT_BROWSER_BIN=agent-browser
# ─── Stripe ────────────────────────────────────────────────────────────────
# Global restricted key (server-side only). NEVER commit the real value;
# the live key lives in .env, which is gitignored.
STRIPE_RK_LIVE=rk_live_REPLACE_ME
# Signing secret for the /api/billing/stripe/webhook endpoint (Stripe
# dashboard -> Developers -> Webhooks -> "Signing secret").
STRIPE_WEBHOOK_SECRET=whsec_REPLACE_ME
