# --- VCS metadata ---
.git
.gitignore
.gitattributes
.github

# --- Virtualenvs ---
.venv
venv
env

# --- Secrets / local config (keep the example template) ---
.env
.env.*
!.env.example

# --- Python build/test caches ---
__pycache__
*.pyc
*.pyo
.pytest_cache

# --- Runtime-generated state (bind mounts / SQLite) ---
output
data

# --- Frontend deps (dev artifacts) ---
# Note: static/dist is NOT excluded -- it is the production SPA bundle that the
# Dockerfile's `COPY static ./static` must pick up. frontend/dist is the Vite
# dev build output (different path) and is excluded.
frontend/node_modules
frontend/dist

# --- Dev-only trees ---
tests
mockups
docs

# --- Editor / OS noise ---
.vscode
.idea
.DS_Store

# --- Docs / logs ---
README.md
*.md
*.log

# --- Agent runtime dirs ---
.claude
.pi
.opencode
